<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TapLab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tap_primary</item>
        <item name="colorOnPrimary">@color/tap_on_primary</item>
        <item name="colorPrimaryContainer">@color/tap_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/tap_primary</item>
        <item name="colorSecondary">@color/tap_secondary</item>
        <item name="colorOnSecondary">@color/tap_on_secondary</item>

        <item name="android:colorBackground">@color/tap_background</item>
        <item name="colorSurface">@color/tap_surface</item>
        <item name="colorOnSurface">@color/tap_on_surface</item>
        <item name="colorSurfaceVariant">@color/tap_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/tap_on_surface_variant</item>
        <item name="colorOutline">@color/tap_outline</item>

        <item name="android:statusBarColor">@color/tap_background</item>
        <item name="android:navigationBarColor">@color/tap_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Card container -->
    <style name="TapLab.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">@dimen/card_margin</item>
    </style>

    <!-- Typography -->
    <style name="TapLab.Text.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TapLab.Text.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/tap_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="TapLab.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TapLab.Text.Helper" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TapLab.Text.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Controls -->
    <style name="TapLab.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">@style/TapLab.Text.Body</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="TapLab.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TapLab.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TapLab.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TapLab.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutline</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
    </style>
</resources>
