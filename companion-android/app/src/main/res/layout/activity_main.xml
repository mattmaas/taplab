<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_md"
        android:paddingTop="@dimen/space_lg"
        android:paddingRight="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <!-- ============ HEADER ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_taplab" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TapLab Companion"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Strap 2 · AirMouse override + Tap Code"
                    android:textAppearance="@style/TapLab.Text.Helper" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ SERVICE STATUS ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingRight="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm">

                    <ImageView
                        android:id="@+id/status_dot"
                        android:layout_width="@dimen/status_dot"
                        android:layout_height="@dimen/status_dot"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dot"
                        app:tint="@color/status_inactive" />

                    <TextView
                        android:id="@+id/status_pill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="Stopped"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:textAppearance="@style/TapLab.Text.Helper" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start"
                        style="@style/TapLab.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="Start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop"
                        style="@style/TapLab.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stop" />
                </LinearLayout>

                <View style="@style/TapLab.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_autostart"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start automatically after reboot" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Recommended. The override resumes on boot without opening the app."
                    android:textAppearance="@style/TapLab.Text.Helper" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ TAP CODE ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Code typing"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="System-wide chord typing"
                        android:textAppearance="@style/TapLab.Text.Body" />

                    <TextView
                        android:id="@+id/tapcode_state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/status_inactive"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_tapcode"
                    style="@style/TapLab.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="Toggle Tap Code typing" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trainer"
                    style="@style/TapLab.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Open Tap Code trainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ AIRMOUSE GUIDE ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entering AirMouse"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <TextView
                    android:id="@+id/text_airmouse_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TapLab.Text.Body" />

                <TextView
                    android:id="@+id/text_airmouse_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:textAppearance="@style/TapLab.Text.Helper" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ AIRMOUSE SETTINGS ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AirMouse settings"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_thumb_middle_override"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Override thumb-middle with media / Back" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Off preserves the native 1/2/3-buzz AirMouse, Multimedia, and Smart TV profile cycle. On restores custom media/Back, but the firmware profile may also cycle."
                    android:textAppearance="@style/TapLab.Text.Helper" />

                <View style="@style/TapLab.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_index_double"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thumb-index double tap = right click" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="When off, every thumb-index tap is an immediate left click and right click is unavailable."
                    android:textAppearance="@style/TapLab.Text.Helper" />

                <View style="@style/TapLab.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_middle_double"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thumb-middle double tap = Back" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="When off, every thumb-middle tap sends media play/pause immediately."
                    android:textAppearance="@style/TapLab.Text.Helper" />

                <View style="@style/TapLab.Divider" />

                <TextView
                    android:id="@+id/label_double_tap_window"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TapLab.Text.Body" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_double_tap_window"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="150"
                    android:valueTo="500" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shorter reduces single-tap latency but makes double taps harder. Longer is more forgiving but delays single actions."
                    android:textAppearance="@style/TapLab.Text.Helper" />

                <View style="@style/TapLab.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_scroll"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inject two-finger scrolling" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ TAP CODE MODE CONTROLS ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Code mode controls"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Simultaneous surface tap chords, not finger-to-thumb gestures. Active only while Tap Code typing is ON and AirMouse is off."
                    android:textAppearance="@style/TapLab.Text.Helper" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_chord_click"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Thumb+Index chord = left click" />

                <View style="@style/TapLab.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_chord_media"
                    style="@style/TapLab.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thumb+Middle chord = play / pause" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ CHORD REFERENCE ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chord reference"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/text_grid_reference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_log_panel"
                        android:padding="@dimen/space_md"
                        android:textAppearance="@style/TapLab.Text.Mono"
                        android:textColor="@color/log_text" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ DIAGNOSTICS ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TapLab.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diagnostics"
                    android:textAppearance="@style/TapLab.Text.Overline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_root"
                        style="@style/TapLab.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="Test root" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_log"
                        style="@style/TapLab.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear log" />
                </LinearLayout>

                <TextView
                    android:id="@+id/log_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_log_panel"
                    android:fontFamily="monospace"
                    android:minHeight="@dimen/log_min_height"
                    android:padding="@dimen/space_md"
                    android:textColor="@color/log_text"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_log_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TapLab.Text.Helper" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
